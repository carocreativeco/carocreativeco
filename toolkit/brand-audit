      if (study.categories.includes(context.weakest)) score += 9;
      if (study.categories.includes(context.secondWeakest)) score += 5;

      study.symptoms.forEach(symptom => {
        if (context.symptoms.includes(symptom)) score += 4;
      });

      if (
        study.id === "athletes-chasing-greatness" &&
        context.orgType === "nonprofit" &&
        (context.symptoms.includes("donor-trust") || context.weakest === "foundation")
      ) score += 10;

      if (
        study.id === "lindsey-tyler-photography" &&
        context.teamSize === "1" &&
        (context.symptoms.includes("faq") || context.goal === "reduce manual work")
      ) score += 10;

      if (
        study.id === "catalyst-consulting" &&
        context.symptoms.includes("lost-leads")
      ) score += 9;

      if (
        study.id === "toniic" &&
        context.symptoms.includes("scattered")
      ) score += 8;

      if (
        study.id === "one-week-missions" &&
        (context.symptoms.includes("ownership") || context.symptoms.includes("founder"))
      ) score += 8;

      return score;
    };

    const buildCaseStudies = context => {
      const ranked = caseStudies
        .map(study => ({ ...study, matchScore: caseStudyScore(study, context) }))
        .sort((a,b) => b.matchScore - a.matchScore)
        .slice(0,2);

      document.getElementById("case-study-results").innerHTML = ranked.map((study, index) => `
        <a class="case-study-card ${index === 0 ? "primary" : "secondary"}" href="${study.url}">
          <div>
            <div class="case-study-number">0${index + 1}</div>
            <div class="case-study-client">${study.client}</div>
            <div class="case-study-tag">${study.tag}</div>
            <h4 class="case-study-title">${study.title}</h4>
            <p class="case-study-relevance">
              <strong>Why it matches:</strong> ${study.summary}
            </p>
          </div>
          <span class="case-study-link">${study.cta}</span>
        </a>
      `).join("");

      return ranked.map(study => study.client);
    };

    const buildCTA = weakest => {
      const cta = CTA_LIBRARY[weakest];
      document.getElementById("cta-title").textContent = cta.title;
      document.getElementById("cta-copy").textContent = cta.copy;
      document.getElementById("cta-link").textContent = cta.label;
      document.getElementById("cta-link").href = `/#contact?audit=${encodeURIComponent(weakest)}`;
      return cta;
    };

    const submitToWebhook = async payload => {
      if (!WEBHOOK_URL) {
        return { skipped: true };
      }

      const response = await fetch(WEBHOOK_URL, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(payload)
      });

      if (!response.ok) {
        throw new Error(`Submission failed with status ${response.status}`);
      }

      return { skipped: false };
    };

    document.getElementById("generate-results").addEventListener("click", async () => {
      const email = document.getElementById("email").value.trim();
      const status = document.getElementById("submit-status");

      if (email && !email.includes("@")) {
        status.textContent = "Please enter a valid email address.";
        return;
      }

      status.textContent = "Generating your audit…";

      const scores = categoryScores();
      const sorted = Object.entries(scores).sort((a,b) => a[1]-b[1]);
      const weakest = sorted[0][0];
      const secondWeakest = sorted[1][0];
      const overall = Math.round(
        Object.values(scores).reduce((sum, value) => sum + value, 0) /
        Object.values(scores).length
      );

      const context = {
        orgName: document.getElementById("orgName").value.trim() || "Your organization",
        orgType: document.getElementById("orgType").value,
        teamSize: document.getElementById("teamSize").value,
        stage: document.getElementById("growthStage").value,
        goal: document.getElementById("primaryGoal").value,
        symptoms: selectedSymptoms(),
        weakest,
        secondWeakest
      };

      const diagnosisResult = diagnosis(scores, weakest, context.orgName, context);
      const matchedStudies = buildCaseStudies(context);
      const cta = buildCTA(weakest);

      document.getElementById("overall-score").textContent = overall;
      document.getElementById("score-caption").textContent = scoreCaption(overall);
      document.getElementById("diagnosis-title").textContent = diagnosisResult.title;
      document.getElementById("diagnosis-copy").textContent = diagnosisResult.copy;

      buildCategoryResults(scores);
      buildRoadmap(scores);

      const payload = {
        source: "Brand Systems Audit Generator",
        submittedAt: new Date().toISOString(),
        firstName: document.getElementById("firstName").value.trim(),
        email,
        organization: context.orgName,
        website: document.getElementById("websiteUrl").value.trim(),
        organizationType: context.orgType,
        teamSize: context.teamSize,
        growthStage: context.stage,
        primaryGoal: context.goal,
        overallScore: overall,
        categoryScores: scores,
        weakestSystem: categories[weakest].name,
        secondWeakestSystem: categories[secondWeakest].name,
        symptoms: context.symptoms,
        diagnosisTitle: diagnosisResult.title,
        diagnosisCopy: diagnosisResult.copy,
        recommendedCTA: cta.label,
        matchedCaseStudies: matchedStudies
      };

      try {
        const submission = await submitToWebhook(payload);
        status.textContent = submission.skipped
          ? "Audit generated. Connect the webhook URL to send submissions into Notion."
          : "Your audit has been generated and submitted.";
      } catch (error) {
        console.error(error);
        status.textContent = "Your audit was generated, but the submission could not be saved.";
      }

      step = 8;
      updateStep();
    });

    document.getElementById("restart").addEventListener("click", () => {
      document.querySelectorAll('input[type="checkbox"]').forEach(el => el.checked = false);
      document.querySelectorAll('input[type="radio"][value="1"]').forEach(el => el.checked = true);
      ["orgName", "firstName", "email", "websiteUrl"].forEach(id => {
        document.getElementById(id).value = "";
      });
      document.getElementById("submit-status").textContent = "";
      step = 1;
      updateStep();
    });
  </script>
</body>
</html>
