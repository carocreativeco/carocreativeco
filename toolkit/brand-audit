<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="Audit the systems behind your brand and receive a personalized roadmap from Caro Creative." />
  <title>Brand Systems Audit Generator | Caro Creative</title>
  <style>
    :root {
      --canvas: #FDFBF7;
      --matcha: #F0F5E6;
      --obsidian: #0F1115;
      --lime: #B5FF3A;
      --line: rgba(15,17,21,.15);
      --muted: #5C625A;
      --white: #FFFFFF;
      --serif: "Ogg", "Recoleta", "Iowan Old Style", Georgia, serif;
      --sans: "Plus Jakarta Sans", "Helvetica Neue", Arial, sans-serif;
      --shadow: 0 22px 70px rgba(15,17,21,.08);
    }

    * { box-sizing: border-box; }
    html { scroll-behavior: smooth; }

    body {
      margin: 0;
      background: var(--canvas);
      color: var(--obsidian);
      font-family: var(--sans);
      line-height: 1.5;
    }

    button, input, select, textarea { font: inherit; }

    .shell {
      width: min(1180px, calc(100% - 32px));
      margin: 0 auto;
    }

    .topbar {
      display: grid;
      grid-template-columns: auto 1fr auto;
      align-items: center;
      gap: 32px;
      padding: 22px 0;
      border-bottom: 1px solid var(--line);
    }

    .brand {
      color: var(--obsidian);
      text-decoration: none;
      display: inline-flex;
      align-items: center;
    }

    .brand img {
      width: 142px;
      max-height: 42px;
      object-fit: contain;
      object-position: left center;
    }

    .brand-fallback {
      display: none;
      font-family: var(--serif);
      font-size: 24px;
      letter-spacing: -.04em;
    }

    .site-nav {
      display: flex;
      justify-content: center;
      gap: clamp(16px, 2vw, 30px);
    }

    .site-nav a,
    .audit-nav {
      font-size: 11px;
      font-weight: 800;
      letter-spacing: .09em;
      text-transform: uppercase;
      text-decoration: none;
      white-space: nowrap;
    }

    .site-nav a { color: var(--obsidian); }

    .audit-nav {
      color: var(--white);
      background: var(--obsidian);
      border-radius: 999px;
      padding: 13px 18px;
    }

    .audit-nav::after {
      content: "↗";
      color: var(--lime);
      margin-left: 8px;
    }

    .mobile-label { display: none; }

    .hero {
      display: grid;
      grid-template-columns: 1.42fr .58fr;
      gap: 36px;
      align-items: end;
      padding: 76px 0 40px;
    }

    .eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      padding: 8px 14px;
      border-radius: 999px;
      background: var(--matcha);
      font-size: 11px;
      font-weight: 800;
      letter-spacing: .1em;
      text-transform: uppercase;
    }

    .eyebrow::before {
      content: "";
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: var(--lime);
      box-shadow: 0 0 0 5px rgba(181,255,58,.22);
    }

    h1, h2, h3, h4, p { margin-top: 0; }

    h1 {
      font-family: var(--serif);
      font-size: clamp(58px, 8.8vw, 126px);
      line-height: .88;
      font-weight: 500;
      letter-spacing: -.055em;
      max-width: 990px;
      margin: 28px 0 30px;
    }

    .hero-copy p {
      font-size: clamp(18px, 2vw, 24px);
      max-width: 760px;
      color: #373C38;
    }

    .hero-card {
      padding: 0;
      min-height: auto;
      display: flex;
      align-items: end;
      justify-content: flex-start;
    }

    .hero-card strong {
      display: none;
    }

    .hero-card ul {
      list-style: none;
      padding: 0;
      margin: 0;
      display: grid;
      gap: 18px;
    }

    .hero-card li {
      font-size: clamp(18px, 1.8vw, 22px);
      color: #4B504B;
      line-height: 1.35;
      display: flex;
      align-items: center;
    }

    .hero-card li::before {
      content: "↗";
      color: var(--lime);
      margin-right: 14px;
      font-size: 24px;
      line-height: 1;
      flex: 0 0 auto;
    }

    .app {
      margin: 40px 0 90px;
      border: 1px solid var(--line);
      border-radius: 44px;
      overflow: hidden;
      box-shadow: var(--shadow);
      background: var(--canvas);
    }

    .app-head {
      display: grid;
      grid-template-columns: 1fr auto;
      gap: 24px;
      align-items: center;
      padding: 27px 34px;
      background: var(--matcha);
      border-bottom: 1px solid var(--line);
    }

    .progress-wrap { display: grid; gap: 9px; }

    .progress-label {
      display: flex;
      justify-content: space-between;
      font-size: 12px;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: .07em;
    }

    .progress {
      height: 8px;
      background: rgba(15,17,21,.1);
      border-radius: 999px;
      overflow: hidden;
    }

    .progress > div {
      height: 100%;
      width: 12.5%;
      background: var(--lime);
      transition: width .3s ease;
    }

    .step-count {
      font-family: var(--serif);
      font-size: 20px;
    }

    .app-body {
      padding: 46px 34px 34px;
      min-height: 650px;
    }

    .step {
      display: none;
      animation: fade .28s ease;
    }

    .step.active { display: block; }

    @keyframes fade {
      from { opacity: 0; transform: translateY(8px); }
      to { opacity: 1; transform: translateY(0); }
    }

    .step h2 {
      font-family: var(--serif);
      font-size: clamp(40px, 5vw, 68px);
      line-height: .98;
      font-weight: 500;
      letter-spacing: -.045em;
      max-width: 900px;
      margin-bottom: 18px;
    }

    .step-intro {
      font-size: 17px;
      color: var(--muted);
      max-width: 790px;
      margin-bottom: 34px;
    }

    .field-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0,1fr));
      gap: 18px;
      max-width: 900px;
    }

    .field {
      display: grid;
      gap: 8px;
    }

    .field.full { grid-column: 1 / -1; }

    label {
      font-size: 12px;
      font-weight: 800;
      letter-spacing: .04em;
    }

    input, select, textarea {
      width: 100%;
      border: 1px solid var(--line);
      border-radius: 18px;
      padding: 16px 17px;
      background: var(--white);
      color: var(--obsidian);
      outline: none;
    }

    input:focus, select:focus, textarea:focus {
      border-color: var(--obsidian);
      box-shadow: 0 0 0 4px rgba(181,255,58,.25);
    }

    textarea { min-height: 110px; resize: vertical; }

    .question-list {
      display: grid;
      gap: 14px;
      max-width: 950px;
    }

    .question {
      display: grid;
      grid-template-columns: 1fr auto;
      gap: 22px;
      align-items: center;
      border: 1px solid var(--line);
      border-radius: 24px;
      padding: 20px 22px;
      background: var(--white);
    }

    .question p {
      margin: 0;
      font-weight: 650;
    }

    .segmented {
      display: inline-flex;
      padding: 4px;
      gap: 3px;
      border-radius: 999px;
      background: #EAE9E3;
    }

    .segmented input { display: none; }

    .segmented label {
      min-width: 72px;
      padding: 9px 12px;
      border-radius: 999px;
      text-align: center;
      cursor: pointer;
      color: #666B64;
      font-size: 11px;
    }

    .segmented input:checked + label {
      background: var(--obsidian);
      color: var(--white);
    }

    .option-grid {
      display: grid;
      grid-template-columns: repeat(4, minmax(0,1fr));
      gap: 14px;
    }

    .option-card { position: relative; }
    .option-card input {
      position: absolute;
      opacity: 0;
      pointer-events: none;
    }

    .option-card label {
      min-height: 138px;
      border: 1px solid var(--line);
      border-radius: 26px;
      padding: 18px;
      background: var(--white);
      cursor: pointer;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      transition: .2s ease;
    }

    .option-card label:hover { transform: translateY(-2px); }

    .option-card input:checked + label {
      background: var(--matcha);
      border-color: var(--obsidian);
      box-shadow: inset 0 0 0 1px var(--obsidian);
    }

    .option-icon {
      width: 42px;
      height: 42px;
      border-radius: 50%;
      display: grid;
      place-items: center;
      background: var(--canvas);
      border: 1px solid var(--line);
      font-size: 18px;
    }

    .option-title {
      font-size: 13px;
      font-weight: 800;
      line-height: 1.25;
    }

    .nav {
      margin-top: 38px;
      padding-top: 26px;
      border-top: 1px solid var(--line);
      display: flex;
      justify-content: space-between;
      gap: 14px;
    }

    .button {
      border: 0;
      border-radius: 999px;
      padding: 15px 22px;
      cursor: pointer;
      text-decoration: none;
      font-weight: 800;
      transition: .2s ease;
    }

    .button:hover { transform: translateY(-1px); }
    .button-primary { background: var(--obsidian); color: var(--white); }
    .button-primary span { color: var(--lime); }
    .button-secondary { background: var(--matcha); color: var(--obsidian); }

    .results-shell { display: grid; gap: 24px; }

    .score-hero {
      display: grid;
      grid-template-columns: .68fr 1.32fr;
      gap: 22px;
    }

    .score-card,
    .diagnosis-card,
    .category-card,
    .roadmap-card,
    .case-study-section,
    .cta-card {
      border: 1px solid var(--line);
      border-radius: 28px;
      padding: 28px;
    }

    .score-card {
      min-height: 330px;
      background: var(--obsidian);
      color: var(--white);
      display: flex;
      flex-direction: column;
      justify-content: space-between;
    }

    .score-label {
      font-size: 11px;
      font-weight: 800;
      letter-spacing: .1em;
      text-transform: uppercase;
      color: rgba(255,255,255,.58);
    }

    .score-number {
      font-family: var(--serif);
      font-size: clamp(82px, 12vw, 150px);
      line-height: .85;
      letter-spacing: -.06em;
      color: var(--lime);
    }

    .diagnosis-card {
      background: var(--matcha);
      display: flex;
      flex-direction: column;
      justify-content: space-between;
    }

    .diagnosis-card h3,
    .section-title {
      font-family: var(--serif);
      font-size: clamp(36px, 5vw, 60px);
      line-height: .98;
      letter-spacing: -.045em;
      font-weight: 500;
      margin: 16px 0 20px;
    }

    .diagnosis-card p {
      max-width: 720px;
      font-size: 18px;
      color: #464C45;
    }

    .category-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0,1fr));
      gap: 14px;
    }

    .category-card {
      background: var(--white);
      min-height: 190px;
    }

    .category-top {
      display: flex;
      justify-content: space-between;
      gap: 14px;
      align-items: center;
      margin-bottom: 28px;
    }

    .category-name {
      font-size: 12px;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: .08em;
    }

    .category-score {
      font-family: var(--serif);
      font-size: 38px;
      line-height: 1;
    }

    .meter {
      height: 7px;
      border-radius: 999px;
      overflow: hidden;
      background: #E9E7E0;
      margin-bottom: 17px;
    }

    .meter div {
      height: 100%;
      background: var(--obsidian);
      border-radius: 999px;
    }

    .category-card p {
      color: var(--muted);
      font-size: 13px;
      margin-bottom: 0;
    }

    .roadmap-card { background: var(--canvas); }

    .roadmap-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0,1fr));
      gap: 14px;
      margin-top: 22px;
    }

    .priority {
      border: 1px solid var(--line);
      border-radius: 24px;
      background: var(--white);
      padding: 21px;
    }

    .priority span {
      display: inline-block;
      padding: 6px 10px;
      border-radius: 999px;
      background: var(--lime);
      font-size: 10px;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: .08em;
      margin-bottom: 16px;
    }

    .priority h4 {
      font-size: 18px;
      margin-bottom: 9px;
    }

    .priority p {
      color: var(--muted);
      font-size: 14px;
      margin-bottom: 0;
    }

    .case-study-section { background: var(--matcha); }

    .case-study-head {
      display: grid;
      grid-template-columns: 1fr minmax(240px, 430px);
      gap: 24px;
      align-items: end;
      margin-bottom: 24px;
    }

    .case-study-head p {
      margin: 0;
      color: var(--muted);
      font-size: 14px;
    }

    .case-study-grid {
      display: grid;
      grid-template-columns: 1.2fr .8fr;
      gap: 15px;
    }

    .case-study-card {
      color: var(--obsidian);
      text-decoration: none;
      min-height: 335px;
      border: 1px solid var(--line);
      border-radius: 28px;
      padding: 25px;
      background: var(--canvas);
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      position: relative;
      overflow: hidden;
      transition: .2s ease;
    }

    .case-study-card:hover { transform: translateY(-3px); }

    .case-study-card.primary {
      background:
        radial-gradient(circle at 90% 4%, rgba(181,255,58,.42), transparent 34%),
        var(--canvas);
    }

    .case-study-card::after {
      content: "↗";
      position: absolute;
      right: 21px;
      top: 21px;
      width: 42px;
      height: 42px;
      border-radius: 50%;
      display: grid;
      place-items: center;
      background: var(--obsidian);
      color: var(--lime);
    }

    .case-study-number {
      width: 48px;
      height: 48px;
      border-radius: 50%;
      display: grid;
      place-items: center;
      background: var(--lime);
      font-weight: 800;
      font-size: 12px;
      margin-bottom: 38px;
    }

    .case-study-client {
      font-size: 11px;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: .12em;
      margin-bottom: 12px;
      max-width: calc(100% - 60px);
    }

    .case-study-tag {
      display: inline-flex;
      align-self: flex-start;
      border: 1px solid var(--line);
      border-radius: 999px;
      padding: 7px 11px;
      background: rgba(181,255,58,.28);
      font-size: 9px;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: .08em;
      margin-bottom: 18px;
    }

    .case-study-title {
      font-family: var(--serif);
      font-size: clamp(30px, 4vw, 50px);
      line-height: .98;
      letter-spacing: -.04em;
      font-weight: 500;
      max-width: 560px;
      margin: 0 0 16px;
    }

    .case-study-card.secondary .case-study-title {
      font-size: clamp(27px, 3.3vw, 40px);
    }

    .case-study-relevance {
      color: #525851;
      font-size: 14px;
      margin-bottom: 0;
      max-width: 650px;
    }

    .case-study-link {
      align-self: flex-start;
      margin-top: 22px;
      border-bottom: 1px solid currentColor;
      font-size: 10px;
      font-weight: 800;
      letter-spacing: .08em;
      text-transform: uppercase;
    }

    .cta-card {
      background: var(--obsidian);
      color: var(--white);
      display: grid;
      grid-template-columns: 1fr auto;
      gap: 28px;
      align-items: center;
    }

    .cta-card h3 {
      font-family: var(--serif);
      font-size: clamp(36px, 5vw, 56px);
      line-height: .98;
      letter-spacing: -.045em;
      font-weight: 500;
      margin-bottom: 13px;
      max-width: 760px;
    }

    .cta-card p {
      color: rgba(255,255,255,.7);
      max-width: 760px;
      margin-bottom: 0;
    }

    .cta-card .button {
      background: var(--lime);
      color: var(--obsidian);
      text-align: center;
      min-width: 220px;
    }

    .lead-form {
      max-width: 850px;
      display: grid;
      gap: 18px;
    }

    .privacy {
      font-size: 11px;
      color: var(--muted);
      margin: 0;
    }

    .submit-status {
      min-height: 22px;
      font-size: 13px;
      font-weight: 700;
    }

    footer {
      padding: 30px 0 50px;
      display: flex;
      justify-content: space-between;
      gap: 20px;
      font-size: 12px;
      color: #666B64;
    }

    @media (max-width: 1080px) {
      .topbar { grid-template-columns: auto 1fr; }
      .site-nav, .audit-nav { display: none; }
      .mobile-label {
        display: block;
        justify-self: end;
        font-size: 11px;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: .08em;
      }
    }

    @media (max-width: 920px) {
      .hero, .score-hero, .cta-card { grid-template-columns: 1fr; }
      .hero-card { padding-top: 6px; }
      .option-grid { grid-template-columns: repeat(2, minmax(0,1fr)); }
      .category-grid, .roadmap-grid { grid-template-columns: 1fr; }
      .case-study-head, .case-study-grid { grid-template-columns: 1fr; }
    }

    @media (max-width: 640px) {
      .shell { width: min(100% - 20px, 1180px); }
      .hero { padding-top: 42px; }
      .app { border-radius: 34px; }
      .app-head, .app-body { padding-left: 20px; padding-right: 20px; }
      .field-grid, .option-grid { grid-template-columns: 1fr; }
      .question { grid-template-columns: 1fr; }
      .segmented { width: 100%; }
      .segmented label { flex: 1; min-width: 0; }
      .nav { flex-direction: column-reverse; }
      .button { width: 100%; text-align: center; }
      footer { flex-direction: column; }
    }

    @media print {
      .topbar, .hero, .app-head, .nav, footer, .cta-card { display: none !important; }
      .app { margin: 0; border: 0; box-shadow: none; }
      .app-body { padding: 0; }
      .step { display: none !important; }
      #step-8 { display: block !important; }
    }
  </style>
</head>
<body>
  <div class="shell">
    <header class="topbar">
      <a class="brand" href="/" aria-label="Caro Creative home">
        <img src="/caro-logo.png" alt="Caro Creative" onerror="this.style.display='none';this.nextElementSibling.style.display='block';">
        <span class="brand-fallback">Caro Creative</span>
      </a>

      <nav class="site-nav" aria-label="Primary navigation">
        <a href="/system-architecture/">System Architecture</a>
        <a href="/client-transformations/">Client Transformations</a>
        <a href="/insights/">Insights</a>
        <a href="/dossier/">Dossier</a>
        <a href="/#faq">FAQ</a>
      </nav>

      <a class="audit-nav" href="/#contact">Request System Audit</a>
      <span class="mobile-label">Brand Systems Audit</span>
    </header>

    <section class="hero">
      <div class="hero-copy">
        <span class="eyebrow">Interactive Brand Diagnostic</span>
        <h1>Audit the systems behind your brand.</h1>
        <p>
          Evaluate the infrastructure supporting your positioning, website, content,
          client experience, operations, and growth. Your results identify the systems
          creating momentum and the gaps creating operational drag.
        </p>
      </div>

      <aside class="hero-card">
        <ul>
          <li>Score six infrastructure categories</li>
          <li>Receive a prioritized systems roadmap</li>
          <li>See relevant client transformations</li>
        </ul>
      </aside>
    </section>

    <main class="app" id="audit-app">
      <div class="app-head">
        <div class="progress-wrap">
          <div class="progress-label">
            <span id="progress-name">Organization profile</span>
            <span id="progress-percent">13%</span>
          </div>
          <div class="progress"><div id="progress-bar"></div></div>
        </div>
        <div class="step-count"><span id="current-step">1</span> / 8</div>
      </div>

      <div class="app-body">
        <section class="step active" id="step-1">
          <h2>Start with the operating context.</h2>
          <p class="step-intro">
            These details help distinguish a visual-brand problem from a deeper infrastructure problem.
          </p>

          <div class="field-grid">
            <div class="field">
              <label for="orgName">Organization name</label>
              <input id="orgName" type="text" placeholder="Business or organization" />
            </div>
            <div class="field">
              <label for="orgType">Organization type</label>
              <select id="orgType">
                <option value="service business">Service business</option>
                <option value="consulting practice">Consulting practice</option>
                <option value="nonprofit">Nonprofit</option>
                <option value="creative business">Creative business</option>
                <option value="small team">Small team</option>
                <option value="other organization">Other organization</option>
              </select>
            </div>
            <div class="field">
              <label for="teamSize">Team size</label>
              <select id="teamSize">
                <option value="1">Just me</option>
                <option value="2-5">2–5 people</option>
                <option value="6-15">6–15 people</option>
                <option value="16+">16+ people</option>
              </select>
            </div>
            <div class="field">
              <label for="growthStage">Current stage</label>
              <select id="growthStage">
                <option value="establishing">Establishing the foundation</option>
                <option value="growing">Growing quickly</option>
                <option value="reorganizing">Reorganizing existing systems</option>
                <option value="scaling">Preparing to scale</option>
                <option value="established">Established but fragmented</option>
              </select>
            </div>
            <div class="field full">
              <label for="primaryGoal">Primary goal</label>
              <select id="primaryGoal">
                <option value="generate more qualified leads">Generate more qualified leads</option>
                <option value="strengthen credibility">Strengthen credibility</option>
                <option value="improve the client journey">Improve the client journey</option>
                <option value="organize content and assets">Organize content and assets</option>
                <option value="reduce manual work">Reduce manual work</option>
                <option value="prepare for growth">Prepare for growth</option>
              </select>
